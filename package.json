{
  "name": "task-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Task Graph skill: maintain task DAGs as Markdown with YAML frontmatter and generate a self-contained read-only HTML viewer.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "task-graph": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "SKILL.md",
    "agents",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && node --test --test-isolation=none \"dist/tests/**/*.test.js\"",
    "test:only": "node --test --test-isolation=none \"dist/tests/**/*.test.js\"",
    "task-graph": "node dist/src/cli.js"
  },
  "dependencies": {
    "marked": "^15.0.7",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "jsdom": "^30.1.0",
    "typescript": "^5.7.3"
  }
}
